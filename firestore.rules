rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function teacher() { return request.auth != null && request.auth.uid == 'UID_DO_PROFESSOR'; }
  function student(id) { return request.auth != null && request.auth.uid == id && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
  function settings() { return get(/databases/$(database)/documents/quiz/settings).data; }
  function valid(id) {
   let d = request.resource.data;
   return d.keys().hasOnly(['id','name','registration','className','answers','total','done','updated','session'])
     && d.id == id && d.name is string && d.name.size() > 0 && d.name.size() <= 120
     && d.registration is string && d.registration.size() > 0 && d.registration.size() <= 40
     && d.className is string && d.className.size() > 0 && d.className.size() <= 40
     && d.total == settings().questions.size() && d.answers is list && d.answers.size() == d.total
     && d.done is bool && d.updated is int && d.session == settings().session;
  }
  match /quiz/settings {
   allow read: if request.auth != null;
   allow write: if teacher();
  }
  match /attempts/{id} {
   allow read: if teacher() || student(id);
   allow create: if student(id) && settings().open == true && valid(id) && request.resource.data.done == false;
   allow update: if student(id) && valid(id) && resource.data.done == false
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','done','updated']);
   allow delete: if teacher();
  }
 }
}
